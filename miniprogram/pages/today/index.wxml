<view class="page">
  <view wx:if="{{view.mode === 'demo'}}" class="demo">体验版本 · 模拟支付与返款</view>
  <view class="brand-row"><view class="wordmark">晨序<text class="brand-dot">.</text></view><view class="brand-caption">THE MORNING PRACTICE<view>90 DAY CLUB</view></view></view>
  <view wx:if="{{error}}" class="error gap" bindtap="retry">{{error}} · 点击重试</view>
  <view wx:if="{{loading}}" class="empty">正在读取你的计划…</view>
  <view class="editorial"><view class="eyebrow">A LITTLE BETTER, EVERY DAY</view><view class="display-title">从今天，<view>找回自己的节奏。</view></view><view class="subtitle">{{view.today}} · {{view.paid ? view.dayLabel : '给自己90天，让健康成为习惯。'}}</view></view>
  <view class="quote"><view class="quote-text">{{view.brand.quote}}</view><view class="quote-author">— {{view.brand.author}}<text> / 原创寄语</text></view></view>
  <block wx:if="{{view && !view.paid}}"><view class="card hero"><view class="eyebrow">YOUR NEXT CHAPTER</view><view class="hero-title">晨练。好好吃饭。<view>一起坚持90天。</view></view><view class="muted">35—55岁 · 每周两天灵活安排</view><view class="divider"></view><view class="row"><view><text class="money-symbol">¥</text><text class="amount">900</text></view><button class="primary" bindtap="enroll">了解并报名</button></view><view class="note">达标按周返，累计最多900元，无额外结营奖金。减脂目标因人而异，不承诺减重结果。</view></view></block>
  <block wx:if="{{view.paid}}">
    <view class="section-heading"><view><view class="eyebrow">YOUR DAILY RITUALS</view><view class="section-title">每天两件小事</view></view><text class="day-number">{{view.dayNumberText}}<text> / 90</text></text></view>
    <view class="ritual-grid"><view class="ritual morning" data-ritual="morning" bindtap="openRitual"><view class="eyebrow">06:20 / MOVE</view><view class="ritual-icon">☼</view><view class="ritual-title">晨练打卡</view><view class="ritual-copy">给身体，一点向上的力量。</view><view class="ritual-bottom">{{view.currentRecord.exerciseDone ? '已记录 ✓' : '去记录'}}<text>↗</text></view></view><view class="ritual evening" data-ritual="evening" bindtap="openRitual"><view class="eyebrow">18:00 / RESET</view><view class="ritual-icon">☾</view><view class="ritual-title">晚间打卡</view><view class="ritual-copy">晚餐早一点，夜晚轻一点。</view><view class="ritual-bottom">{{view.currentRecord.dietDone ? '已记录 ✓' : '去记录'}}<text>↗</text></view></view></view>
    <view wx:if="{{!view.started}}" class="card"><view class="section-title">{{view.day < 1 ? '好习惯，即将开始' : '本期结束，习惯继续'}}</view><view class="muted">{{view.camp.startDate}}开营 · {{view.camp.title}}</view><button wx:if="{{view.localDemo && view.day < 1}}" class="secondary gap" bindtap="jump">演示：跳至我的开营日</button></view>
    <view wx:if="{{view.started && activeRitual}}" id="ritual-form" class="card"><view class="eyebrow">{{activeRitual === 'morning' ? 'MORNING CHECK-IN' : 'EVENING CHECK-IN'}}</view><view class="section-title gap">{{activeRitual === 'morning' ? '清晨，为自己出发。' : '认真吃饭，从容收尾。'}}</view>
      <block wx:if="{{activeRitual === 'morning'}}"><view class="notice">循序渐进，按个人计划活动。无需为了打卡强行跑满一小时；不适时休息并寻求评估。</view><view class="field"><view class="label">今天的活动</view><picker range="{{exercises}}" value="{{exerciseIndex}}" bindchange="chooseExercise"><view class="picker">{{exercises[exerciseIndex]}}　⌄</view></picker></view><view class="field"><view class="label">活动时长 / 分钟</view><input class="input" type="number" value="{{minutes}}" data-field="minutes" bindinput="input" maxlength="3"/></view><view class="row switch-row"><text>按个人运动计划完成</text><switch checked="{{exerciseDone}}" color="#263b31" data-field="exerciseDone" bindchange="toggle"/></view></block>
      <block wx:if="{{activeRitual === 'evening'}}"><view class="notice">晚餐是一顿完整的正餐。默认18:00前完成，之后不安排加餐；健康与用药需要优先。</view><view class="field"><view class="label">晚餐完成时间</view><picker mode="time" value="{{dinnerTime}}" bindchange="chooseDinner"><view class="picker">{{dinnerTime}}　⌄</view></picker></view><view class="row switch-row"><text>今天三餐按个人计划搭配</text><switch checked="{{dietDone}}" color="#263b31" data-field="dietDone" bindchange="toggle"/></view><view class="row switch-row"><text>晚餐后按计划未安排加餐</text><switch checked="{{eveningDone}}" color="#263b31" data-field="eveningDone" bindchange="toggle"/></view></block>
      <button class="primary gap" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{activeRitual === 'morning' ? '保存晨练记录 ↗' : '保存晚间记录 ↗'}}</button><view class="note">两项均完成才计为有效日；分开保存不会重复计天。{{view.currentRecord.status === 'complete' ? '今天已完成 ✓' : '以自己的节奏，完成今天。'}}</view>
    </view>
  </block>
  <view class="section-heading"><view><view class="eyebrow">THE DAILY TABLE</view><view class="section-title">好好吃，每一餐。</view></view><text class="tag">自由搭配 ↗</text></view>
  <view class="plate-banner"><view class="plate"><view class="plate-inner">½<view>蔬菜</view></view></view><view class="grow"><view class="plate-title">丰富一点，刚刚好。</view><view class="muted">半盘蔬菜，一份蛋白质，适量主食。<view>不用复杂计算，从一顿均衡的饭开始。</view></view></view></view>
  <view class="meal-list"><view wx:for="{{view.mealCards}}" wx:key="id" class="meal-row" data-meal="{{item.id}}" bindtap="nutrition"><view class="meal-time">{{item.time}}</view><view class="grow"><view class="eyebrow">{{item.english}}</view><view class="meal-name">{{item.name}}<text class="meal-status">{{item.needsReview ? '偏好已变，请调整' : (item.saved ? '我的搭配' : '推荐搭配')}}</text></view><view class="muted">{{item.text}}</view></view><text class="meal-arrow">↗</text></view></view>
  <block wx:if="{{view.paid}}"><view class="section-heading"><view><view class="eyebrow">CONSISTENCY OVER PERFECTION</view><view class="section-title">{{view.period.label}} · 我的节奏</view></view><text class="badge">可返 ¥{{view.period.reward}}</text></view><view class="card calendar"><view class="row"><view><text class="amount">{{view.period.valid}}</text><text class="muted"> / {{view.period.required}} 有效日</text></view><text class="tag">剩余灵活日 {{view.period.remainingExempt}}</text></view><view class="week"><view wx:for="{{view.period.rows}}" wx:key="date" class="day"><view>{{item.short}}</view><view class="dot {{item.status}}">{{item.symbol}}</view></view></view><view class="note">✓ 有效　半 部分完成　免 灵活安排　— 未记录</view><button wx:if="{{view.started}}" class="plain gap" disabled="{{busy}}" bindtap="exempt">今天使用免打卡</button></view><view class="refund-line"><view class="row"><text>累计返款资格</text><text class="refund-amount">¥{{view.eligible}}<text> / 900</text></text></view><view class="note">已退款 ¥{{view.refunded}} · 前12周各70元，最后6天60元。<view>累计返款不超过900元，无额外结营奖金。</view></view></view></block>
  <view class="footer-note">晨序 · 让改变，自然发生。<view>MOVE WELL. EAT WELL. LIVE WELL.</view></view>
</view>
