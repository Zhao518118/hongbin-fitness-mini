<view class="page">
  <view wx:if="{{view.mode === 'demo'}}" class="demo">模拟演示 · 请勿填写真实病史或其他敏感资料</view>
  <view class="eyebrow">MY OWN PACE</view><view class="title">每一步，都算数。</view>
  <view wx:if="{{error}}" class="error gap" bindtap="retry">{{error}} · 点击重试</view>
  <view wx:if="{{loading}}" class="empty">正在读取你的记录…</view>
  <view wx:if="{{view}}" class="card"><view class="row"><view class="row"><view class="avatar">{{view.isAdmin ? '营' : '我'}}</view><view><view class="section-title" style="margin-bottom:0">{{view.me.nickname}}</view><view class="muted">{{view.paid ? view.camp.title : '尚未入营'}} · {{view.healthLabel}}</view></view></view><text class="badge">{{view.isAdmin ? '管理员' : '一起变好'}}</text></view></view>
  <view wx:if="{{view.localDemo}}" class="card"><view class="section-title">演示控制台</view><view class="muted">默认虚构成员已有第一周记录。切换“新报名用户”可体验从健康筛查到模拟支付。</view><picker range="{{roles}}" bindchange="switchRole"><view class="picker gap">切换演示身份　⌄</view></picker><button class="plain small-button gap" bindtap="reset">重置本机演示数据</button></view>
  <button wx:if="{{view.isAdmin}}" class="primary gap" bindtap="admin">进入管理工作台</button>
  <button wx:if="{{view && !view.paid && !view.isAdmin}}" class="primary gap" bindtap="enroll">了解并报名</button>
  <block wx:if="{{view.paid}}">
    <view class="card"><view class="row"><view class="section-title">身体记录 · 仅本人和授权管理可见</view></view><view class="row"><view class="metric"><view class="metric-number">{{view.latestWeight}}</view><view class="metric-label">最近体重 / 公斤</view></view><view class="metric"><view class="metric-number">{{view.weightChange === null ? '—' : view.weightChange}}</view><view class="metric-label">相对初始变化 / 公斤</view></view></view><view wx:for="{{view.bodyRows}}" wx:key="date" class="bar-row"><text>{{item.date}}</text><view class="grow"><view class="bar" style="width:{{item.bar}}%"></view></view><text>{{item.weight}} kg</text></view><view class="note">条形仅表示记录值，不是预测。建议同条件每周称重一次，腰围每两周记录一次。</view><view class="row field"><view class="grow"><view class="label">体重 / 公斤</view><input class="input" type="digit" data-field="weight" value="{{weight}}" bindinput="input" placeholder="如81.4"/></view><view class="grow"><view class="label">腰围 / 厘米（选填）</view><input class="input" type="digit" data-field="waist" value="{{waist}}" bindinput="input" placeholder="如95"/></view></view><button class="secondary gap" disabled="{{busy}}" bindtap="saveBody">保存今天的身体记录</button></view>
    <view class="card"><view class="section-title">返款进度</view><view class="row"><view class="metric"><view class="metric-number">¥{{view.eligible}}</view><view class="metric-label">累计取得资格</view></view><view class="metric"><view class="metric-number">¥{{view.refunded}}</view><view class="metric-label">已退款</view></view></view><view class="note">累计上限900元，不设置额外结营奖金。</view><view wx:if="{{!view.refunds.length}}" class="empty">周期结束后，达标返款记录显示在这里。</view><view wx:for="{{view.refunds}}" wx:key="id" class="list-row row"><view>{{item.label}}<view class="muted">{{item.statusLabel}}{{item.mode === 'demo' ? ' · 模拟' : ''}}</view></view><text>¥{{item.amount}}</text></view></view>
    <view class="card"><view class="section-title">我的13个周期</view><view wx:for="{{view.weekly}}" wx:key="index" class="list-row row"><view>{{item.label}}<view class="muted">{{item.start}} — {{item.end}}</view></view><text class="badge">{{item.valid}}/{{item.required}}天 · {{item.settlement === 'qualified' ? '达标已结算' : (item.settlement === 'not_qualified' ? '本期未达标' : '待周期结算')}}</text></view></view>
  </block>
  <view wx:if="{{view.orders.length}}" class="card"><view class="section-title">我的订单</view><view wx:for="{{view.orders}}" wx:key="id" class="list-row"><view class="row"><text>¥{{item.amount}}</text><text class="badge">{{item.status === 'paid' ? '已支付' : '待支付'}}{{view.mode === 'demo' ? ' · 模拟' : ''}}</text></view><view class="note break">{{item.id}} · 规则快照 {{item.rulesVersion}}</view></view></view>
  <view wx:if="{{view}}" class="card"><view class="section-title">申请与帮助</view><view class="notice">生病或受伤请先休息、就医，不为打卡硬撑。申请由人工处理，相关争议周期暂缓结算。</view><picker range="{{requestTypes}}" value="{{requestType}}" bindchange="chooseRequest"><view class="picker gap">{{requestTypes[requestType]}}　⌄</view></picker><textarea class="textarea gap" value="{{reason}}" maxlength="300" data-field="reason" bindinput="input" placeholder="简要说明，不上传病历、证件。未入营用户可提交个人数据申请。"/><button class="secondary gap" disabled="{{busy}}" bindtap="request">提交申请</button><view wx:for="{{view.requests}}" wx:key="id" class="list-row"><view>{{item.type}} · {{item.status === 'pending' ? '待处理' : '已处理'}}</view><view class="muted">{{item.reason}}</view><view wx:if="{{item.resolution}}" class="note">处理说明：{{item.resolution}}</view></view><view class="note">演示模式只进入本机队列，暂无在线客服。真实运营联系渠道尚待配置。紧急医疗情况请拨打120。</view></view>
  <view class="card"><view class="list-row link" data-type="health" bindtap="agreement">健康风险告知</view><view class="list-row link" data-type="privacy" bindtap="agreement">隐私与健康信息处理说明</view><view class="list-row link" data-type="terms" bindtap="agreement">服务、返款与退出规则</view></view>
  <view class="footer-note">个人数据不参与公开减重排名。</view>
</view>
