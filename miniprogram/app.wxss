page{background:#f6f7f2;color:#20392e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:30rpx;line-height:1.65}
view,text,button,input,textarea{box-sizing:border-box}button::after{border:0}button{margin:0;font-size:30rpx;border-radius:20rpx;font-weight:600;line-height:1.5;padding:23rpx 28rpx;min-height:88rpx}button[disabled]{opacity:.5}
.page{padding:28rpx 32rpx 56rpx}.demo{background:#fff2d9;color:#865a17;border:1rpx solid #ead2a3;border-radius:14rpx;padding:14rpx 20rpx;font-size:24rpx;margin-bottom:30rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#6e8276;font-weight:600}.title{font-size:48rpx;line-height:1.35;font-weight:700;margin:10rpx 0}.subtitle,.muted{color:#758379;font-size:26rpx}.section-title{font-size:32rpx;font-weight:650;margin-bottom:22rpx}.card{background:#fff;border:1rpx solid #e5ebe3;border-radius:26rpx;padding:28rpx;margin-top:24rpx}.hero{background:#185b46;color:#fff;border:0;padding:34rpx}.hero .muted{color:#c9e0d3}.hero-title{font-size:42rpx;line-height:1.4;font-weight:650;margin:18rpx 0}.hero .eyebrow{color:#b0d6bd}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.start{align-items:flex-start}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.gap{margin-top:22rpx}.small-gap{margin-top:12rpx}.primary{background:#176b50;color:white}.secondary{background:#edf3ed;color:#265b44}.plain{background:transparent;color:#47634f;border:1rpx solid #d5e2d5}.danger{color:#a14637;background:#fff1eb}.small-button{font-size:25rpx;padding:14rpx 20rpx;min-height:64rpx}.hero .primary{background:#e1efb6;color:#24412d}.badge{font-size:23rpx;padding:5rpx 16rpx;border-radius:999rpx;background:#eff4e6;color:#49653a;display:inline-block;white-space:nowrap}.tag{font-size:23rpx;color:#687c68}.amount{font-size:55rpx;line-height:1.2;font-weight:700;font-family:Arial,sans-serif}.money-symbol{font-size:30rpx}.metric{text-align:center;flex:1}.metric-number{font-size:40rpx;font-weight:650}.metric-label{font-size:24rpx;color:#78877c;margin-top:6rpx}.divider{height:1rpx;background:#e9eee6;margin:24rpx 0}.progress{height:12rpx;background:#e7eee4;border-radius:20rpx;overflow:hidden;margin-top:18rpx}.progress-fill{height:100%;background:#85b88c;border-radius:20rpx}.week{display:flex;justify-content:space-between;margin-top:24rpx;gap:8rpx}.day{text-align:center;flex:1;font-size:21rpx;color:#7d8b80}.dot{border-radius:50%;width:60rpx;height:60rpx;margin:8rpx auto;background:#f0f3ec;display:flex;align-items:center;justify-content:center;font-size:27rpx;color:#8a9689}.dot.complete{background:#176b50;color:#fff}.dot.exempt{background:#f9ecd2;color:#8d6b30}.dot.partial{background:#e9eed5;color:#667b44}.note{font-size:25rpx;color:#788374;line-height:1.75;margin-top:16rpx}.notice{background:#f5f5ea;border-radius:16rpx;padding:18rpx 22rpx;color:#69724c;font-size:25rpx}.label{font-size:28rpx;font-weight:550;margin-bottom:12rpx}.input,.picker{background:#f6f8f3;border:1rpx solid #dce6da;border-radius:14rpx;padding:20rpx;min-height:86rpx;width:100%;font-size:30rpx}.textarea{background:#f6f8f3;border:1rpx solid #dce6da;border-radius:18rpx;width:100%;min-height:200rpx;padding:20rpx;font-size:29rpx}.field{margin-top:22rpx}.switch-row{padding:16rpx 0;min-height:80rpx}.list-row{padding:20rpx 0;border-bottom:1rpx solid #edf0e9}.list-row:last-child{border-bottom:0}.empty{padding:35rpx 12rpx;text-align:center;color:#7b897c}.error{padding:20rpx;background:#fff0e9;color:#9a4b39;border-radius:16rpx}.link{color:#176b50;text-decoration:underline;font-size:26rpx}.footer-note{text-align:center;font-size:22rpx;color:#8e998b;padding:30rpx 0}.post-text{white-space:pre-wrap;word-break:break-all;line-height:1.85;margin-top:20rpx}.avatar{background:#e9eedc;color:#526e45;width:74rpx;height:74rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:30rpx}.post-image{width:100%;height:330rpx;border-radius:16rpx;margin-top:16rpx}.pill{background:#edf2e8;border-radius:12rpx;padding:9rpx 14rpx;font-size:25rpx}.bar-row{display:flex;align-items:center;gap:16rpx;font-size:25rpx;margin-top:14rpx}.bar{height:14rpx;background:#84af87;border-radius:20rpx;min-width:10rpx}.legal{font-size:28rpx;line-height:1.9;white-space:pre-wrap}.check-label{display:flex;align-items:flex-start;gap:12rpx;padding:15rpx 0;font-size:27rpx}.compact{font-size:24rpx}.warning{color:#9d6235}.admin-grid{display:flex;gap:14rpx;flex-wrap:wrap}.admin-grid button{flex:1;min-width:220rpx}.break{word-break:break-all}.step{color:#65816b;font-size:24rpx;margin:12rpx 0}.readonly{opacity:.8}
